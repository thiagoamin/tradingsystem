{
	"version": "2.0.0",
	"tasks": [
		/* -------------------------------- Configure ------------------------------- */
		{
			"label": "📈 CMake: Configure Dev",
			"type": "cmake",
			"command": "configure",
			"preset": "dev",
			"group": "build"
		},
		{
			"label": "🧪 CMake: Configure Test",
			"type": "cmake",
			"command": "configure",
			"preset": "test",
			"group": "build"
		},
		{
			"label": "🔬 CMake: Configure Bench Debug",
			"type": "cmake",
			"command": "configure",
			"preset": "bench-debug",
			"group": "build"
		},
		{
			"label": "🔬🚀 CMake: Configure Bench Release",
			"type": "cmake",
			"command": "configure",
			"preset": "bench",
			"group": "build"
		},
		{
			"label": "🚀 CMake: Configure Prod",
			"type": "cmake",
			"command": "configure",
			"preset": "prod",
			"group": "build"
		},
		/* ---------------------------------- Build --------------------------------- */
		{
			"label": "📈 Build: Dev",
			"type": "shell",
			"command": "time cmake --build --preset dev",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🧪 Build: Test",
			"type": "shell",
			"command": "time cmake --build --preset test",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🔬 Build: Bench Debug",
			"type": "shell",
			"command": "time cmake --build --preset bench-debug",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🔬🚀 Build: Bench Release",
			"type": "shell",
			"command": "time cmake --build --preset bench",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🚀 Build: Prod",
			"type": "shell",
			"command": "time cmake --build --preset prod",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		/* ------------------------------- Clean Build ------------------------------ */
		{
			"label": "📈 Clean Build: Dev",
			"type": "shell",
			"command": "cmake --preset dev && time cmake --build --preset dev --clean-first",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🧪 Clean Build: Test",
			"type": "shell",
			"command": "cmake --preset test && time cmake --build --preset test --clean-first",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🔬 Clean Build: Bench Debug",
			"type": "shell",
			"command": "cmake --preset bench-debug && time cmake --build --preset bench-debug --clean-first",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🔬🚀 Clean Build: Bench Release",
			"type": "shell",
			"command": "cmake --preset bench && time cmake --build --preset bench --clean-first",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🚀 Clean Build: Prod",
			"type": "shell",
			"command": "cmake --preset prod && time cmake --build --preset prod --clean-first",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		/* -------------------------------- Utilities ------------------------------- */
		{
			"label": "Format C++ Code 🍭",
			"type": "shell",
			"command": "python3 scripts/utilities/fix_formatting.py",
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		}
	]
}