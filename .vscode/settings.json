{
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.aux": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.synctex.gz": true,
    "**/*.toc": true
  },
  "cmake.useCMakePresets": "always",
  "cmake.defaultConfigurePreset": "dev",
  "cmake.configureOnEdit": false,
  "cmake.configureOnOpen": false,
  "cmake.ctest.allowParallelJobs": true,
  "testMate.cpp.test.executables": "${workspaceFolder}/build_test/test/*_tests",
  "C_Cpp.clang_format_style": "file"
}